{
  "expo": {
    "name": "SmartLife Assist",
    "slug": "smartlifeassist",
    "scheme": "smartlifeassist",

    "icon": "./assets/images/icon.png",

    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9C27B0"
    },

    "android": {
      "package": "com.smartlifeassist.app",

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#9C27B0"
      },

      "config": {
        "googleMaps": {
          "apiKey": "YOUR-API-KEY"
        }
      }
    },

    "plugins": [
      "expo-sqlite",
      "expo-task-manager",
      "expo-background-fetch"
      
    ],

    "extra": {
      "eas": {
        "projectId": "07ea7680-2c1d-4239-9f3d-3d93e188a45d"
      }
    }
  }
}
